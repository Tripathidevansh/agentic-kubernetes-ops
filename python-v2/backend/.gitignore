# ==============================================================================
# Python Backend Git Ignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
.env.*
*.env

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.DS_Store
.vscode/
.idea/
